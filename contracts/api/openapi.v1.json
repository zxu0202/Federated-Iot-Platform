{
  "openapi": "3.1.0",
  "info": {
    "title": "Federated IoT Platform S1 API",
    "version": "0.4",
    "description": "M0 v0.4 / Requirement V0.8 / Architecture 0.7 control-plane contract. The first implementation profile is PostgreSQL only."
  },
  "servers": [{"url": "/api/v1"}],
  "paths": {
    "/datasets": {
      "post": {
        "operationId": "createDataset",
        "summary": "Stream a strict seven-column CSV and enqueue Worker preflight.",
        "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"type": "object", "required": ["file"], "properties": {"file": {"type": "string", "format": "binary"}, "display_name": {"type": "string", "maxLength": 1024}, "timezone": {"type": "string", "maxLength": 128}}}}}},
        "responses": {"202": {"description": "Dataset persisted as VALIDATING.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DatasetEnvelope"}}}}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/datasets/{dataset_id}": {
      "get": {"operationId": "getDataset", "parameters": [{"$ref": "#/components/parameters/DatasetID"}], "responses": {"200": {"description": "Dataset metadata and preflight state.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DatasetEnvelope"}}}}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/configuration/reference-profile": {
      "get": {"operationId": "getReferenceProfile", "responses": {"200": {"description": "The single immutable REFERENCE profile.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReferenceProfileEnvelope"}}}}}}
    },
    "/parameter-profiles": {
      "get": {"operationId": "listParameterProfiles", "parameters": [{"$ref": "#/components/parameters/Cursor"}, {"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"description": "Immutable profile page."}}},
      "post": {"operationId": "createParameterProfile", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateParameterProfile"}}}}, "responses": {"200": {"description": "The same canonical CUSTOM values already exist; the existing alias is unchanged.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ParameterProfileEnvelope"}}}}, "201": {"description": "A new immutable CUSTOM value version was created.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ParameterProfileEnvelope"}}}}, "422": {"$ref": "#/components/responses/Error"}}}
    },
    "/parameter-profiles/{version_id}": {
      "get": {"operationId": "getParameterProfile", "parameters": [{"$ref": "#/components/parameters/VersionID"}], "responses": {"200": {"description": "Parameter profile values plus server-owned constraints.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ParameterProfileEnvelope"}}}}, "404": {"$ref": "#/components/responses/Error"}}},
      "patch": {"operationId": "updateParameterProfileDisplayName", "parameters": [{"$ref": "#/components/parameters/VersionID"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RenameParameterProfile"}}}}, "responses": {"200": {"description": "Only the CUSTOM human-readable alias changed; canonical values and hash are unchanged.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ParameterProfileEnvelope"}}}}, "404": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}}
    },
    "/parameter-profiles/{version_id}/export": {
      "get": {"operationId": "exportParameterProfile", "parameters": [{"$ref": "#/components/parameters/VersionID"}], "responses": {"200": {"description": "Normalized JSON profile.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ParameterProfile"}}}}}}
    },
    "/parameter-profiles/import": {
      "post": {"operationId": "importParameterProfile", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ParameterProfile"}}}}, "responses": {"200": {"description": "Same normalized hash already exists."}, "201": {"description": "New immutable CUSTOM version."}, "422": {"$ref": "#/components/responses/Error"}}}
    },
    "/load-mapping-profiles": {
      "get": {"operationId": "listLoadMappingProfiles", "responses": {"200": {"description": "Immutable mapping profiles."}}},
      "post": {"operationId": "createLoadMappingProfile", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateMappingProfile"}}}}, "responses": {"201": {"description": "Identity mapping created."}, "422": {"$ref": "#/components/responses/Error"}}}
    },
    "/load-mapping-profiles/{version_id}": {
      "get": {"operationId": "getLoadMappingProfile", "parameters": [{"$ref": "#/components/parameters/VersionID"}], "responses": {"200": {"description": "Mapping profile."}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/simulations": {
      "get": {"operationId": "listSimulations", "parameters": [{"$ref": "#/components/parameters/Cursor"}, {"$ref": "#/components/parameters/Limit"}, {"name": "run_id", "in": "query", "schema": {"type": "string"}}, {"name": "status", "in": "query", "schema": {"type": "string"}}, {"name": "date_from", "in": "query", "schema": {"type": "string", "format": "date-time"}}, {"name": "date_to", "in": "query", "schema": {"type": "string", "format": "date-time"}}, {"name": "dataset_id", "in": "query", "schema": {"type": "string"}}, {"name": "parameter_profile_version_id", "in": "query", "schema": {"type": "string"}}, {"name": "run_mode", "in": "query", "schema": {"$ref": "#/components/schemas/RunMode"}}, {"name": "search", "in": "query", "schema": {"type": "string", "maxLength": 256}, "description": "Server-side search across run_id and the frozen dataset display name."}, {"name": "view", "in": "query", "schema": {"enum": ["history", "queue"]}}], "responses": {"200": {"description": "Stable history or queue page."}}},
      "post": {"operationId": "createSimulation", "parameters": [{"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 16, "maxLength": 128}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateSimulation"}}}}, "responses": {"200": {"description": "Idempotent replay.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SimulationEnvelope"}}}}, "202": {"description": "Immutable simulation snapshot queued.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SimulationEnvelope"}}}}, "409": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}}}
    },
    "/simulations/{run_id}": {
      "get": {"operationId": "getSimulation", "parameters": [{"$ref": "#/components/parameters/RunID"}], "responses": {"200": {"description": "Authoritative persistent run state."}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/simulations/{run_id}/cancel": {
      "post": {"operationId": "cancelSimulation", "parameters": [{"$ref": "#/components/parameters/RunID"}], "requestBody": {"content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "properties": {"reason": {"type": "string", "maxLength": 256}}}}}}, "responses": {"200": {"description": "Queued cancellation or idempotent terminal result."}, "202": {"description": "Persistent running cancellation intent."}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/simulations/{run_id}/rerun": {
      "post": {"operationId": "rerunSimulation", "parameters": [{"$ref": "#/components/parameters/RunID"}, {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 16, "maxLength": 128}}], "responses": {"202": {"description": "New immutable run from an existing terminal run."}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/simulations/{run_id}/events": {
      "get": {"operationId": "simulationEvents", "parameters": [{"$ref": "#/components/parameters/RunID"}, {"name": "Last-Event-ID", "in": "header", "schema": {"type": "integer", "minimum": 0}}], "responses": {"200": {"description": "Persistent SSE stream. Expired cursors receive stream.reset.", "content": {"text/event-stream": {"schema": {"type": "string"}}}}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/simulations/{run_id}/summary": {
      "get": {"operationId": "getSimulationSummary", "parameters": [{"$ref": "#/components/parameters/RunID"}, {"$ref": "#/components/parameters/SummaryAgent"}], "responses": {"200": {"description": "Completed frozen summary and chart."}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/simulations/{run_id}/results": {
      "get": {"operationId": "getSimulationResults", "parameters": [{"$ref": "#/components/parameters/RunID"}, {"$ref": "#/components/parameters/Agent"}, {"$ref": "#/components/parameters/Cursor"}, {"name": "limit", "in": "query", "schema": {"type": "integer", "default": 200, "maximum": 2000}}, {"name": "index_from", "in": "query", "schema": {"type": "integer", "minimum": 0}}, {"name": "index_to", "in": "query", "schema": {"type": "integer", "minimum": 0}}, {"name": "from", "in": "query", "schema": {"type": "string", "format": "date-time"}}, {"name": "to", "in": "query", "schema": {"type": "string", "format": "date-time"}}], "responses": {"200": {"description": "Paged point-result.v1 data."}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/simulations/{run_id}/alarms": {
      "get": {"operationId": "getSimulationAlarms", "parameters": [{"$ref": "#/components/parameters/RunID"}, {"$ref": "#/components/parameters/Agent"}, {"$ref": "#/components/parameters/Cursor"}, {"$ref": "#/components/parameters/Limit"}, {"name": "level", "in": "query", "style": "form", "explode": true, "schema": {"type": "array", "items": {"type": "string", "enum": ["None", "Notice", "Warning", "Alarm"]}}}, {"name": "type", "in": "query", "style": "form", "explode": true, "schema": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 128}}}, {"name": "from", "in": "query", "schema": {"type": "string", "format": "date-time"}}, {"name": "to", "in": "query", "schema": {"type": "string", "format": "date-time"}}, {"name": "index_from", "in": "query", "schema": {"type": "integer", "minimum": 0}}, {"name": "index_to", "in": "query", "schema": {"type": "integer", "minimum": 0}}], "responses": {"200": {"description": "Paged indexed alarms with a filtered total independent of cursor and limit.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AlarmPageEnvelope"}}}}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/simulations/{run_id}/replay": {
      "get": {"operationId": "getReplayWindow", "parameters": [{"$ref": "#/components/parameters/RunID"}, {"$ref": "#/components/parameters/Agent"}, {"$ref": "#/components/parameters/Cursor"}, {"name": "index_from", "in": "query", "schema": {"type": "integer", "minimum": 0}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "maximum": 2000}}], "responses": {"200": {"description": "Deterministic frozen results window."}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/simulations/{run_id}/replay-export": {
      "get": {"operationId": "exportReplay", "parameters": [{"$ref": "#/components/parameters/RunID"}, {"$ref": "#/components/parameters/Agent"}, {"name": "format", "in": "query", "required": true, "schema": {"const": "zip"}}], "responses": {"200": {"description": "Streamed ZIP with replay CSV and JSON manifest.", "content": {"application/zip": {"schema": {"type": "string", "format": "binary"}}}}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/simulations/{run_id}/artifacts": {
      "get": {"operationId": "listArtifacts", "parameters": [{"$ref": "#/components/parameters/RunID"}], "responses": {"200": {"description": "Committed artifact metadata only."}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/simulations/{run_id}/artifacts/{artifact_name}": {
      "get": {"operationId": "downloadArtifact", "parameters": [{"$ref": "#/components/parameters/RunID"}, {"name": "artifact_name", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[^/\\\\]+$"}}], "responses": {"200": {"description": "Streamed, database-registered artifact."}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/health/live": {"get": {"operationId": "live", "responses": {"200": {"description": "Process liveness."}}}},
    "/health/ready": {"get": {"operationId": "ready", "responses": {"200": {"description": "PostgreSQL, storage, profile, and contract readiness."}, "503": {"$ref": "#/components/responses/Error"}}}}
  },
  "components": {
    "parameters": {
      "DatasetID": {"name": "dataset_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
      "RunID": {"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
      "VersionID": {"name": "version_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
      "Agent": {"name": "agent", "in": "query", "required": true, "schema": {"type": "integer", "enum": [1, 2, 3]}},
      "SummaryAgent": {"name": "agent", "in": "query", "schema": {"oneOf": [{"type": "integer", "enum": [1, 2, 3]}, {"const": "aggregate"}], "default": "aggregate"}},
      "Cursor": {"name": "cursor", "in": "query", "schema": {"type": "string"}},
      "Limit": {"name": "limit", "in": "query", "schema": {"type": "integer", "default": 100, "minimum": 1, "maximum": 500}}
    },
    "responses": {"Error": {"description": "Stable error response.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}},
    "schemas": {
      "RunMode": {"type": "string", "enum": ["REFERENCE", "CUSTOM"]},
      "ParameterTree": {"type": "object", "minProperties": 1, "additionalProperties": {"anyOf": [{"type": "object", "minProperties": 1, "additionalProperties": true}, {"type": "number"}, {"type": "integer"}, {"type": "boolean"}, {"type": "string"}, {"type": "null"}]}},
      "SparseParameterTree": {"type": "object", "additionalProperties": {"anyOf": [{"type": "object", "additionalProperties": true}, {"type": "number"}, {"type": "integer"}, {"type": "boolean"}, {"type": "string"}, {"type": "null"}]}},
      "SimulationAgentBinding": {"type": "object", "additionalProperties": false, "required": ["agent", "parameters"], "properties": {"agent": {"type": "integer", "enum": [1, 2, 3]}, "parameters": {"type": "object", "maxProperties": 0, "description": "Per-run overrides are forbidden; use a saved CUSTOM profile."}}},
      "ProfileAgentOverride": {"type": "object", "additionalProperties": false, "required": ["agent", "parameters"], "properties": {"agent": {"type": "integer", "enum": [1, 2, 3]}, "segment": {"type": "string", "enum": ["EARLY", "MIDDLE", "LATE"]}, "parameters": {"$ref": "#/components/schemas/SparseParameterTree"}}},
      "EffectiveAgentParameters": {"type": "object", "additionalProperties": false, "required": ["agent", "segment", "parameters"], "properties": {"agent": {"type": "integer", "enum": [1, 2, 3]}, "segment": {"type": "string", "enum": ["EARLY", "MIDDLE", "LATE"]}, "parameters": {"$ref": "#/components/schemas/ParameterTree"}}},
      "ParameterConstraint": {"type": "object", "additionalProperties": false, "required": ["type", "editable", "nullable", "minimum", "maximum", "allowed_values"], "properties": {"type": {"type": "string", "enum": ["integer", "number", "boolean", "string"]}, "editable": {"type": "boolean"}, "nullable": {"type": "boolean"}, "minimum": {"type": ["number", "null"]}, "maximum": {"type": ["number", "null"]}, "allowed_values": {"type": ["array", "null"], "items": {}}}},
      "ParameterConstraints": {"type": "object", "additionalProperties": false, "required": ["contract_version", "paths"], "properties": {"contract_version": {"const": "parameter-constraints.v1"}, "paths": {"type": "object", "minProperties": 69, "maxProperties": 69, "additionalProperties": {"$ref": "#/components/schemas/ParameterConstraint"}}}},
      "CreateSimulation": {"type": "object", "additionalProperties": false, "required": ["dataset_id", "run_mode", "parameter_profile_version_id", "load_mapping_version_id", "agent_overrides", "seed"], "properties": {"dataset_id": {"type": "string"}, "run_mode": {"$ref": "#/components/schemas/RunMode"}, "parameter_profile_version_id": {"type": "string"}, "load_mapping_version_id": {"type": "string"}, "agent_overrides": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/components/schemas/SimulationAgentBinding"}}, "seed": {"type": "integer", "minimum": 1}, "display_name": {"type": "string", "maxLength": 256}}},
      "CreateParameterProfile": {"type": "object", "additionalProperties": false, "required": ["display_name", "base_version_id", "shared_parameters", "agents"], "properties": {"display_name": {"type": "string", "minLength": 1, "maxLength": 128}, "base_version_id": {"const": "reference-v1"}, "shared_parameters": {"$ref": "#/components/schemas/ParameterTree"}, "agents": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/components/schemas/ProfileAgentOverride"}}}},
      "RenameParameterProfile": {"type": "object", "additionalProperties": false, "required": ["display_name"], "properties": {"display_name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:.*\\S)?$"}}},
      "CreateMappingProfile": {"type": "object", "additionalProperties": false, "required": ["display_name", "mapping_type", "parameters", "result_unit"], "properties": {"display_name": {"type": "string"}, "mapping_type": {"const": "identity"}, "parameters": {"type": "object", "maxProperties": 0}, "result_unit": {"const": "A"}}},
      "ParameterProfile": {"type": "object", "required": ["version_id", "mode", "display_name", "immutable", "contract_version", "shared_parameters", "agents", "fixed_items", "constraints", "editable_paths", "normalized_sha256", "created_at", "updated_at"], "properties": {"version_id": {"type": "string"}, "mode": {"$ref": "#/components/schemas/RunMode"}, "display_name": {"type": "string", "minLength": 1, "maxLength": 128}, "base_version_id": {"type": ["string", "null"]}, "immutable": {"const": true}, "contract_version": {"const": "parameter-profile.v1"}, "shared_parameters": {"$ref": "#/components/schemas/ParameterTree"}, "agents": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/components/schemas/ProfileAgentOverride"}}, "fixed_items": {"type": "object"}, "constraints": {"$ref": "#/components/schemas/ParameterConstraints"}, "editable_paths": {"type": "array", "minItems": 67, "maxItems": 67, "uniqueItems": true, "items": {"type": "string"}}, "normalized_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}}},
      "DatasetSnapshot": {"type": "object", "required": ["dataset_id", "display_name", "sha256", "timezone", "columns"], "properties": {"dataset_id": {"type": "string"}, "display_name": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "timezone": {"type": "string"}, "columns": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "string"}}}},
      "DatasetPreflightError": {"type": "object", "additionalProperties": false, "required": ["code", "message", "stage", "diagnostic_id", "recoverable"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "stage": {"type": ["string", "null"]}, "diagnostic_id": {"type": "string"}, "recoverable": {"type": "boolean"}, "agent": {"type": ["integer", "null"], "enum": [1, 2, 3, null]}}},
      "DatasetPreflight": {"type": "object", "additionalProperties": false, "required": ["job_id", "status", "queue_position", "stage", "attempt_id", "lease_state", "latest_event_id", "contract_version", "error"], "properties": {"job_id": {"type": "string"}, "status": {"type": "string", "enum": ["QUEUED", "RUNNING", "COMPLETED", "CANCELLED", "FAILED", "FAILED_RECOVERABLE"]}, "queue_position": {"type": ["integer", "null"], "minimum": 1}, "stage": {"type": ["string", "null"]}, "attempt_id": {"type": ["string", "null"]}, "lease_state": {"type": "string", "enum": ["NOT_CLAIMED", "ACTIVE", "RELEASED", "EXPIRED"]}, "latest_event_id": {"type": ["integer", "null"], "minimum": 1}, "contract_version": {"const": "preprocessing.v1"}, "error": {"oneOf": [{"$ref": "#/components/schemas/DatasetPreflightError"}, {"type": "null"}]}}},
      "AlgorithmPreprocessing": {"type": "object", "additionalProperties": false, "required": ["schema_version", "preprocessing_contract_version", "input_sha256", "counts", "time", "filter_path", "parameters", "summary_sha256"], "properties": {"schema_version": {"type": "string"}, "preprocessing_contract_version": {"type": "string"}, "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "counts": {"type": "object", "additionalProperties": false, "required": ["raw_rows", "invalid_numeric_rows", "stop_rows", "suspicious_rows", "running_rows", "spike_rows"], "properties": {"raw_rows": {"type": "integer", "minimum": 0}, "invalid_numeric_rows": {"type": "integer", "minimum": 0}, "stop_rows": {"type": "integer", "minimum": 0}, "suspicious_rows": {"type": "integer", "minimum": 0}, "running_rows": {"type": "integer", "minimum": 0}, "spike_rows": {"type": "integer", "minimum": 0}}}, "time": {"type": "object", "additionalProperties": false, "required": ["start", "end", "parse_failed_count", "non_monotonic_count", "sampling_period_ms"], "properties": {"start": {"type": ["string", "null"]}, "end": {"type": ["string", "null"]}, "parse_failed_count": {"type": "integer", "minimum": 0}, "non_monotonic_count": {"type": "integer", "minimum": 0}, "sampling_period_ms": {"type": "object", "additionalProperties": false, "required": ["median", "min", "max"], "properties": {"median": {"type": ["number", "null"]}, "min": {"type": ["number", "null"]}, "max": {"type": ["number", "null"]}}}}}, "filter_path": {"type": "object"}, "parameters": {"type": "object"}, "summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
      "SimulationParameterSnapshot": {"type": "object", "required": ["version_id", "display_name", "normalized_sha256", "contract_version", "mode", "shared_parameters", "agents", "fixed_items", "effective_parameters"], "properties": {"version_id": {"type": "string"}, "display_name": {"type": "string"}, "normalized_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "contract_version": {"const": "parameter-profile.v1"}, "mode": {"$ref": "#/components/schemas/RunMode"}, "base_version_id": {"type": ["string", "null"]}, "shared_parameters": {"$ref": "#/components/schemas/ParameterTree"}, "agents": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/components/schemas/ProfileAgentOverride"}}, "fixed_items": {"type": "object"}, "effective_parameters": {"type": "object", "required": ["shared_parameters", "agents"], "properties": {"shared_parameters": {"$ref": "#/components/schemas/ParameterTree"}, "agents": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/components/schemas/EffectiveAgentParameters"}}}}}},
      "Dataset": {"type": "object", "required": ["dataset_id", "display_name", "original_filename", "status", "sha256", "size_bytes", "columns", "timezone", "utc_offset", "statistics", "preflight", "algorithm_preprocessing", "validation_started_at", "validation_finished_at", "created_at"], "properties": {"dataset_id": {"type": "string"}, "display_name": {"type": "string"}, "original_filename": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+$"}, "status": {"type": "string", "enum": ["UPLOADING", "VALIDATING", "VALID", "INVALID"]}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size_bytes": {"type": "integer", "minimum": 0}, "columns": {"type": "array", "prefixItems": [{"const": "Time_base"}, {"const": "dzdl_1"}, {"const": "dzdl_2"}, {"const": "dzdl_3"}, {"const": "dzdl_4"}, {"const": "zl"}, {"const": "sd"}], "minItems": 7, "maxItems": 7}, "timezone": {"type": "string"}, "utc_offset": {"type": "string"}, "statistics": {"type": "object"}, "preflight": {"$ref": "#/components/schemas/DatasetPreflight"}, "algorithm_preprocessing": {"oneOf": [{"$ref": "#/components/schemas/AlgorithmPreprocessing"}, {"type": "null"}]}, "validation_started_at": {"type": ["string", "null"], "format": "date-time"}, "validation_finished_at": {"type": ["string", "null"], "format": "date-time"}, "created_at": {"type": "string", "format": "date-time"}}},
      "Simulation": {"type": "object", "required": ["run_id", "status", "cancellable", "run_mode", "snapshot_sha256", "dataset_snapshot", "parameter_snapshot", "created_at"], "properties": {"run_id": {"type": "string"}, "status": {"type": "string", "enum": ["CREATED", "VALIDATING", "QUEUED", "RUNNING", "CANCELLING", "GENERATING_ARTIFACTS", "COMPLETED", "CANCELLED", "FAILED", "FAILED_RECOVERABLE"]}, "cancellable": {"type": "boolean", "description": "Database-authoritative cancellation capability; clients must not invent can_cancel."}, "current_stage": {"type": ["string", "null"], "enum": ["PREPROCESSING", "LOCAL_TRAINING", "ANCHOR_AGGREGATING", "GLOBAL_DISTILLING", "CALIBRATING", "TESTING", null]}, "queue_position": {"type": ["integer", "null"], "minimum": 1}, "run_mode": {"$ref": "#/components/schemas/RunMode"}, "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "dataset_snapshot": {"$ref": "#/components/schemas/DatasetSnapshot"}, "parameter_snapshot": {"$ref": "#/components/schemas/SimulationParameterSnapshot"}, "created_at": {"type": "string", "format": "date-time"}}},
