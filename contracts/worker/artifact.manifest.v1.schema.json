{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact.manifest.v1.schema.json",
  "title": "Algorithm Worker Artifact Manifest",
  "description": "Strict manifest emitted atomically by a successful S1 simulation task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_mode",
    "snapshot_sha256",
    "result_schema_version",
    "created_at",
    "items"
  ],
  "properties": {
    "schema_version": { "const": "artifact.manifest.v1" },
    "run_id": { "$ref": "#/$defs/opaqueId" },
    "run_mode": { "enum": ["CUSTOM", "REFERENCE"] },
    "snapshot_sha256": {
      "description": "SHA-256 of the frozen parameter snapshot from worker.task.v1 parameter_snapshot.sha256; this is not the full admission snapshot hash stored by the Backend.",
      "$ref": "#/$defs/sha256"
    },
    "result_schema_version": { "const": "point-result.v1" },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "items": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "allOf": [
    {
      "properties": {
        "items": {
          "contains": {
            "type": "object",
            "properties": { "name": { "const": "run_manifest.json" }, "required": { "const": true } },
            "required": ["name", "required"]
          }
        }
      }
    },
    {
      "properties": {
        "items": {
          "contains": {
            "type": "object",
            "properties": { "name": { "const": "preprocessing_summary.json" }, "required": { "const": true } },
            "required": ["name", "required"]
          }
        }
      }
    },
    {
      "properties": {
        "items": {
          "contains": {
            "type": "object",
            "properties": { "name": { "const": "agent_partition_summary.csv" }, "required": { "const": true } },
            "required": ["name", "required"]
          }
        }
      }
    },
    {
      "properties": {
        "items": {
          "contains": {
            "type": "object",
            "properties": { "name": { "const": "feature_schema.json" }, "required": { "const": true } },
            "required": ["name", "required"]
          }
        }
      }
    },
    {
      "properties": {
        "items": {
          "contains": {
            "type": "object",
            "properties": { "name": { "const": "anchor_summary.json" }, "required": { "const": true } },
            "required": ["name", "required"]
          }
        }
      }
    },
    {
      "properties": {
        "items": {
          "contains": {
            "type": "object",
            "properties": { "name": { "const": "metrics.csv" }, "required": { "const": true } },
            "required": ["name", "required"]
          }
        }
      }
    },
    {
      "properties": {
        "items": {
          "contains": {
            "type": "object",
            "properties": { "name": { "const": "results_agent_1.csv" }, "required": { "const": true } },
            "required": ["name", "required"]
          }
        }
      }
    },
    {
      "properties": {
        "items": {
          "contains": {
            "type": "object",
            "properties": { "name": { "const": "results_agent_2.csv" }, "required": { "const": true } },
            "required": ["name", "required"]
          }
        }
      }
    },
    {
      "properties": {
        "items": {
          "contains": {
            "type": "object",
            "properties": { "name": { "const": "results_agent_3.csv" }, "required": { "const": true } },
            "required": ["name", "required"]
          }
        }
      }
    },
    {
      "properties": {
        "items": {
          "contains": {
            "type": "object",
            "properties": { "name": { "const": "alarms.csv" }, "required": { "const": true } },
            "required": ["name", "required"]
          }
        }
      }
    },
    {
      "properties": {
        "items": {
          "contains": {
            "type": "object",
            "properties": { "name": { "const": "diagnostics.json" }, "required": { "const": true } },
            "required": ["name", "required"]
          }
        }
      }
    }
  ],
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeLogicalPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "media_type", "size_bytes", "sha256", "required"],
      "properties": {
        "name": {
          "allOf": [
            { "$ref": "#/$defs/safeLogicalPath" },
            { "not": { "const": "artifact_manifest.json" } }
          ]
        },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(?:;[A-Za-z0-9!#$&^_.+-]+=[A-Za-z0-9!#$&^_.+-]+)*$"
        },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "required": { "type": "boolean" }
      }
    }
  }
}
