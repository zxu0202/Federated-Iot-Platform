**/wheelhouse/*
!/algorithm-worker/wheelhouse/.gitkeep
!/algorithm-worker/wheelhouse/SHA256SUMS

# Go outputs and locally restored dependency trees. Public Git source keeps
# go.mod/go.sum but does not track backend/vendor.
**/bin/
*.test
*.out
**/vendor/

