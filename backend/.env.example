# PostgreSQL-only S1 Web/API configuration. Do not put secrets in this file.
IOT_HTTP_ADDRESS=127.0.0.1:8080
IOT_DATABASE_URL=postgres://replace-with-runtime-credential@postgres:5432/federated_iot?sslmode=disable
IOT_DATASET_ROOT=/var/lib/iot
IOT_ARTIFACT_ROOT=/var/lib/iot
IOT_UPLOAD_LIMIT_BYTES=524288000
IOT_LEASE_SECONDS=60
IOT_HEARTBEAT_SECONDS=10
IOT_SERVICE_VERSION=dev
# Supply release-specific immutable values through the offline deployment package.
IOT_ALGORITHM_VERSION=
IOT_WORKER_VERSION=
IOT_WORKER_IMAGE_DIGEST=
IOT_NUMERIC_RUNTIME=
# Explicit local JSON file. Missing, unreadable, or incomplete constraints make
# readiness fail; there is no implicit parameter allowlist fallback.
IOT_PARAMETER_CONSTRAINTS_FILE=/etc/federated-iot/parameter-constraints.v1.json
