# Public connected-source build profile. Copying this file is not sufficient:
# Build-ConnectedSourceImages.ps1 writes the verified source revision and the
# BuildKit worker manifest digest to the ignored .env.connected.runtime file.
# Never put credentials in proxy or registry URLs.

BUILD_PROFILE=connected-source
COMPOSE_PROJECT_NAME=federated-iot-platform-connected
PLATFORM_CONFIG_PATH=./config/platform.yaml
PARAMETER_CONSTRAINTS_SOURCE=./config/parameter-constraints.v1.json

PLATFORM_BIND_ADDRESS=0.0.0.0
PLATFORM_BIND_INTERFACE=
PLATFORM_CANDIDATE_INTERFACES=
HOST_API_PORT=8080

POSTGRES_IMAGE=docker.io/library/postgres:18.6-bookworm@sha256:7d2695c3aa88e792e8b3b233e7e4adb296a20412c6c0ca361e3edaaacfada108
GO_BUILDER_IMAGE=docker.io/library/golang:1.23.0-bookworm@sha256:32096e84705b30bb39cc9c65ef2896efacc4268203b7876049847763cefc934d
NODE_BUILDER_IMAGE=docker.io/library/node:14.18.0-bullseye@sha256:7816ee1e305841a4e551933e21b3d79727b8e0645a03186b75be7089f010cfbc
WEB_RUNTIME_IMAGE=docker.io/library/debian:12.12-slim@sha256:d5d3f9c23164ea16f31852f95bd5959aad1c5e854332fe00f7b3a20fcc9f635c
PYTHON_BUILDER_IMAGE=docker.io/library/python:3.12.12-bookworm@sha256:c0abd0758831ad99b7a29e0c1a875da9c4abb9a2e3f21e2eeb585dbcadfb6cd0
PYTHON_RUNTIME_IMAGE=docker.io/library/python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c

CONNECTED_GOPROXY=https://proxy.golang.org,direct
CONNECTED_GOSUMDB=sum.golang.org
CONNECTED_NPM_REGISTRY=https://registry.npmmirror.com
CONNECTED_PYPI_INDEX_URL=https://pypi.org/simple

WEB_API_IMAGE=zx/federated-iot-platform:1.0.0-m1-connected
ALGORITHM_WORKER_IMAGE=zx/federated-iot-platform-worker:1.0.0-m1-connected
BUILD_VERSION=1.0.0-m1
FRONTEND_VERSION=1.0.0-m1
BACKEND_VERSION=1.0.0-m1
ALGORITHM_VERSION=1.0.0-m1
WORKER_VERSION=1.0.0-m1
WORKER_INSTANCE_ID=algorithm-worker-1
PYTHON_PACKAGE_VERSION=1.0.0.dev1
WORKER_IMAGE_DIGEST=CONNECTED_BUILD_REQUIRED
NUMERIC_RUNTIME=python-3.12.12
VCS_REF=SOURCE_REVISION_REQUIRED

POSTGRES_DB=federated_iot
POSTGRES_ADMIN_USER=platform_admin
WEB_API_DB_USER=web_api
MIGRATOR_DB_USER=platform_migrator
WORKER_REPOSITORY_OWNER=platform_worker_repository_owner
WORKER_DB_USER=algorithm_worker

POSTGRES_ADMIN_PASSWORD_SOURCE=./secrets/postgres_admin_password.txt
WEB_API_DB_PASSWORD_SOURCE=./secrets/web_api_db_password.txt
MIGRATOR_DB_PASSWORD_SOURCE=./secrets/platform_migrator_db_password.txt
WORKER_DB_PASSWORD_SOURCE=./secrets/algorithm_worker_db_password.txt

TZ=Asia/Shanghai
WEB_API_CPU_LIMIT=0.5
WEB_API_MEMORY_LIMIT=512m
WEB_API_PIDS_LIMIT=256
MIGRATION_CPU_LIMIT=0.25
MIGRATION_MEMORY_LIMIT=256m
MIGRATION_PIDS_LIMIT=128
WORKER_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=1536m
WORKER_PIDS_LIMIT=512
WORKER_NUMERIC_THREADS=2
POSTGRES_CPU_LIMIT=0.5
POSTGRES_MEMORY_LIMIT=768m
POSTGRES_PIDS_LIMIT=256
LOG_MAX_SIZE=20m
LOG_MAX_FILE=5
