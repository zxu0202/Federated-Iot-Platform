# Copy this file to .env and replace every RELEASE_FREEZE_REQUIRED value only
# after the release-freeze image manifest has been independently verified.
# Do not store passwords here. Each password variable points to a local secret file.

COMPOSE_PROJECT_NAME=federated-iot-platform
PLATFORM_CONFIG_PATH=./config/platform.yaml
PARAMETER_CONSTRAINTS_SOURCE=./config/parameter-constraints.v1.json

# Publish Web/API on all host IPv4 interfaces by default. Set a host-assigned
# IPv4 address, or use a BindAddress/BindInterface startup argument, only when
# an operator intentionally needs to restrict ingress to one interface.
PLATFORM_BIND_ADDRESS=0.0.0.0
PLATFORM_BIND_INTERFACE=
PLATFORM_CANDIDATE_INTERFACES=
HOST_API_PORT=8080

# All image references must contain an exact tag and a verified digest at release freeze.
POSTGRES_IMAGE=RELEASE_FREEZE_REQUIRED
GO_BUILDER_IMAGE=RELEASE_FREEZE_REQUIRED
NODE_BUILDER_IMAGE=RELEASE_FREEZE_REQUIRED
WEB_RUNTIME_IMAGE=RELEASE_FREEZE_REQUIRED
PYTHON_BUILDER_IMAGE=RELEASE_FREEZE_REQUIRED
PYTHON_RUNTIME_IMAGE=RELEASE_FREEZE_REQUIRED

# These local build tags document M1 output names only. The startup validator
# rejects them until release promotion supplies immutable digest references.
WEB_API_IMAGE=zx/federated-iot-platform:1.0.0-m1
ALGORITHM_WORKER_IMAGE=zx/federated-iot-platform-worker:1.0.0-m1
BUILD_VERSION=1.0.0-m1
FRONTEND_VERSION=1.0.0-m1
BACKEND_VERSION=1.0.0-m1
ALGORITHM_VERSION=1.0.0-m1
WORKER_VERSION=1.0.0-m1
WORKER_INSTANCE_ID=algorithm-worker-1
PYTHON_PACKAGE_VERSION=1.0.0.dev1
WORKER_IMAGE_DIGEST=RELEASE_FREEZE_REQUIRED
NUMERIC_RUNTIME=python-3.12.12
VCS_REF=unknown

POSTGRES_DB=federated_iot
POSTGRES_ADMIN_USER=platform_admin
WEB_API_DB_USER=web_api
# These names are fixed by the PostgreSQL ACL contract and must not be reused
# by a runtime service.
MIGRATOR_DB_USER=platform_migrator
WORKER_REPOSITORY_OWNER=platform_worker_repository_owner
WORKER_DB_USER=algorithm_worker

POSTGRES_ADMIN_PASSWORD_SOURCE=./secrets/postgres_admin_password.txt
WEB_API_DB_PASSWORD_SOURCE=./secrets/web_api_db_password.txt
MIGRATOR_DB_PASSWORD_SOURCE=./secrets/platform_migrator_db_password.txt
WORKER_DB_PASSWORD_SOURCE=./secrets/algorithm_worker_db_password.txt

TZ=Asia/Shanghai
WEB_API_CPU_LIMIT=0.5
WEB_API_MEMORY_LIMIT=512m
WEB_API_PIDS_LIMIT=256
MIGRATION_CPU_LIMIT=0.25
MIGRATION_MEMORY_LIMIT=256m
MIGRATION_PIDS_LIMIT=128
WORKER_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=1536m
WORKER_PIDS_LIMIT=512
WORKER_NUMERIC_THREADS=2
POSTGRES_CPU_LIMIT=0.5
POSTGRES_MEMORY_LIMIT=768m
POSTGRES_PIDS_LIMIT=256
LOG_MAX_SIZE=20m
LOG_MAX_FILE=5
