    given-names: "Xu"
    affiliation: ""
    orcid: "https://orcid.org/<0000-0002-2768-5623>"

keywords:
  - industrial Internet of Things
  - power-load prediction
  - alarm analysis
  - multi-agent simulation
  - uncertainty quantification
  - Docker
  - PostgreSQL
  - reproducible research software